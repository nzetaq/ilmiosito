{#- Prefisso degli asset. Vuoto per la home, che sta alla radice: i
    percorsi relativi valgono sia su www.nzetaq.it sia sull'indirizzo
    di ripiego nzetaq.github.io/ilmiosito/. La pagina 404, servita a
    qualsiasi profondità, ha invece bisogno di percorsi assoluti. -#}
{%- set base = radice | default('', true) -%}

{#- I due blocchi inline della pagina sono catturati qui, prima di
    essere stampati più sotto: dalla stessa variabile si ricava
    l'impronta da dichiarare nella policy di sicurezza, e questo
    garantisce che impronta e codice non possano divergere. -#}
{%- set avvio -%}
    (function () {
      var radice = document.documentElement;

      try {
        if (localStorage.getItem('au-theme') === 'light') {
          radice.classList.add('theme-light');
        }
      } catch (e) {}

      // Le regolazioni della veste, applicate prima del primo disegno:
      // arrivando col resto del JavaScript, la pagina apparirebbe alla
      // misura sbagliata e si riassesterebbe sotto gli occhi di chi
      // legge. Si passa dal CSSOM e non da un foglio di stile aggiunto:
      // la policy di sicurezza ammette il primo e non il secondo.
      // Le formule sono le stesse di veste.js.
      try {
        // Quanto è grande: diretta, 150% è una volta e mezza.
        var scala = parseInt(localStorage.getItem('au-scala'), 10);
        if (scala >= 100 && scala <= 300) {
          radice.style.setProperty('--scala', scala / 100);
        }
        // Quanto si muove: inversa, perché la percentuale è una
        // velocità e il tempo ne è il reciproco. Lo zero è a parte.
        var moto = parseInt(localStorage.getItem('au-moto'), 10);
        if (moto >= 0 && moto <= 100) {
          radice.style.setProperty('--moto', moto > 0 ? 100 / moto : 0);
        }
      } catch (e) {}

      // La sezione da mostrare è scritta nell'indirizzo. Va letta qui,
      // prima che il corpo della pagina sia disegnato: il router più
      // avanti si limiterà a subentrare.
      var valide = [{% for s in site.sezioni %}'{{ s.id }}'{% if not loop.last %}, {% endif %}{% endfor %}];
      var sezione = 'home';
      try {
        var id = decodeURIComponent(location.hash.replace(/^#/, ''));
        if (valide.indexOf(id) !== -1) sezione = id;
      } catch (e) {}
      radice.setAttribute('data-sez', sezione);
    })();
{%- endset -%}

{%- set stileSenzaJs -%}
      /* Il selettore è volutamente più specifico di quello del foglio
         principale: così queste regole vincono per specificità e non
         per ordine di dichiarazione. */
      :root .au-section { display: block; opacity: 1; }
      :root .au-nav { display: none; }
      /* Senza JavaScript i cursori non fanno nulla: ingannerebbero. */
      :root .au-regolatori { display: none; }
{%- endset -%}
<!DOCTYPE html>
<html lang="{{ site.lingua }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {#- Content Security Policy. Il sito non ha moduli, né login, né
     contenuti scritti da altri: la policy non ripara una falla
     esistente, ma limita il danno se un giorno finisse nella pagina
     del codice non voluto. Tutto viene da qui ('self'), i due blocchi
     inline sono ammessi per impronta, e l'unica destinazione esterna
     consentita è il conteggio delle visite.
     Va dichiarata in un meta perché GitHub Pages non permette di
     impostare intestazioni HTTP. Per la stessa ragione manca
     frame-ancestors, che in un meta non è ammesso: contro l'inclusione
     in una cornice altrui, su Pages, non c'è rimedio. #}
  <meta http-equiv="Content-Security-Policy" content="
    default-src 'none';
    base-uri 'none';
    {#- Nessun modulo può spedire da nessuna parte, tranne dove una
        pagina lo dichiari con `moduli`. Il modulo dei contatti è
        l'unico del sito che parte davvero: quello dell'oracolo viene
        fermato dal JavaScript, e quello della redazione non è un
        modulo che si spedisce. -#}
    form-action {% if moduli %}{{ moduli }}{% else %}'none'{% endif %};
    img-src 'self';
    font-src 'self';
    style-src 'self' {{ stileSenzaJs | impronta | safe }};
    script-src 'self' {{ avvio | impronta | safe }};
    {#- 'self' serve all'Intelligenza Artificiosa, che alla prima
        domanda scarica l'indice dei testi del sito. È il permesso più
        stretto possibile: nessun'altra origine è raggiungibile.
        `reti` la allarga per una singola pagina — la redazione, che
        deve parlare con l'API di GitHub — e non per tutto il sito. -#}
    connect-src 'self'{% if site.analisi.goatcounter %} https://{{ site.analisi.goatcounter }}.goatcounter.com{% endif %}{% if reti %} {{ reti }}{% endif %};
  ">

  <title>{{ titolo or site.titolo }}</title>
  <meta name="description" content="{{ descrizione or site.descrizione }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- endif %}

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.titolo }}">
  <meta property="og:title" content="{{ titolo or site.titolo }}">
  <meta property="og:description" content="{{ descrizione or site.descrizione }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="it_IT">
  <meta name="twitter:card" content="summary">

  <meta name="theme-color" content="#151d33" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#f6f2e7" media="(prefers-color-scheme: light)">
  <link rel="icon" href="{{ base }}assets/img/favicon.svg" type="image/svg+xml">

  {%- if site.analisi.goatcounter %}
  {#- Codice del sito su GoatCounter. Finché resta vuoto in site.json,
      questo meta non compare e non viene caricato alcuno script. #}
  <meta name="analisi-codice" content="{{ site.analisi.goatcounter }}">
  {%- endif %}

  {#- Stato deciso prima del primo disegno, così la pagina non appare
     mai in una veste che va poi corretta sotto gli occhi di chi legge:
     né il tema sbagliato, né la sezione sbagliata. Il codice è quello
     catturato in cima al file, di cui la policy dichiara l'impronta. #}
  <script>{{ avvio | safe }}</script>

  {#- I caratteri stanno in assets/font/ e sono dichiarati in cima al
     foglio di stile: nessuna richiesta a Google, nessun terzo fra il
     lettore e la pagina. Il precaricamento riguarda i due file del
     sottoinsieme latino, gli unici che servono quasi sempre. #}
  <link rel="preload" href="{{ base }}assets/font/archivo-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ base }}assets/font/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>

  {#- L'impronta nell'indirizzo lega la pagina alla versione esatta del
     foglio che le serve. Su GitHub Pages i file restano in cache dieci
     minuti e non si può cambiare: senza questo, una pagina nuova può
     ritrovarsi con lo stile vecchio, e basta un nome di classe cambiato
     perché la pagina si scomponga. -#}
  <link rel="stylesheet" href="{{ base }}assets/css/style.css?v={{ 'src/assets/css/style.css' | versione }}">
  {%- if foglioExtra %}
  {#- Un foglio in più per una pagina sola: la redazione non deve pesare
     sul foglio che scaricano tutti gli altri. -#}
  <link rel="stylesheet" href="{{ base }}assets/css/{{ foglioExtra }}.css?v={{ ('src/assets/css/' + foglioExtra + '.css') | versione }}">
  {%- endif %}
  {%- set entrata = modulo | default('main', true) %}
  <script type="module" src="{{ base }}assets/js/{{ entrata }}.js?v={{ ('src/assets/js/' + entrata + '.js') | versione }}"></script>

  {#- Senza JavaScript il router non può nascondere nulla: si mostra
     tutto, così la pagina resta leggibile e navigabile per intero. #}
  <noscript>
    <style>{{ stileSenzaJs | safe }}</style>
  </noscript>
</head>
<body>
{{ content | safe }}
</body>
</html>
