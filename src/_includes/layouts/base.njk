{#- Prefisso degli asset. Vuoto per la home, che sta alla radice: i
    percorsi relativi valgono sia su www.nzetaq.it sia sull'indirizzo
    di ripiego nzetaq.github.io/ilmiosito/. La pagina 404, servita a
    qualsiasi profondità, ha invece bisogno di percorsi assoluti. -#}
{%- set base = radice | default('', true) -%}

{#- I due blocchi inline della pagina sono catturati qui, prima di
    essere stampati più sotto: dalla stessa variabile si ricava
    l'impronta da dichiarare nella policy di sicurezza, e questo
    garantisce che impronta e codice non possano divergere. -#}
{%- set avvio -%}
    (function () {
      var radice = document.documentElement;

      // La veste, scritta su <html> prima del primo disegno: arrivando
      // col resto del JavaScript si vedrebbe la pagina cambiare colore
      // sotto gli occhi.
      //
      // Le vecchie chiavi vanno tradotte, non ignorate: chi torna dopo
      // mesi non deve ritrovarsi il sito cambiato. 'light' era il
      // chiaro di quando i temi erano due; 'carta' era il fondo caldo,
      // che oggi non c'è più e il cui parente prossimo è Giorno.
      var scegli = function (chiave, ammessi, ripiego, traduci) {
        try {
          var v = localStorage.getItem(chiave);
          if (traduci && traduci[v]) v = traduci[v];
          if (ammessi.indexOf(v) !== -1) return v;
        } catch (e) {}
        return ripiego;
      };
      radice.setAttribute('data-stile', scegli(
        'au-stile',
        [{% for s in site.stili %}'{{ s.id }}'{% if not loop.last %}, {% endif %}{% endfor %}],
        '{{ site.stili[0].id }}'));
      radice.setAttribute('data-tema', scegli(
        'au-tema',
        [{% for t in site.temi %}'{{ t.id }}'{% if not loop.last %}, {% endif %}{% endfor %}],
        '{{ site.temi[0].id }}',
        { carta: 'giorno' }));
      try {
        if (!localStorage.getItem('au-tema') && localStorage.getItem('au-theme') === 'light') {
          radice.setAttribute('data-tema', 'giorno');
        }
      } catch (e) {}

      // Le regolazioni della veste, applicate prima del primo disegno:
      // arrivando col resto del JavaScript, la pagina apparirebbe alla
      // misura sbagliata e si riassesterebbe sotto gli occhi di chi
      // legge. Si passa dal CSSOM e non da un foglio di stile aggiunto:
      // la policy di sicurezza ammette il primo e non il secondo.
      // Le formule sono le stesse di veste.js.
      try {
        // Quanto è grande: diretta, 150% è una volta e mezza.
        var scala = parseInt(localStorage.getItem('au-scala'), 10);
        if (scala >= 100 && scala <= 300) {
          radice.style.setProperty('--scala', scala / 100);
        }
        // Quanto si muove: inversa, perché la percentuale è una
        // velocità e il tempo ne è il reciproco. Lo zero è a parte.
        var moto = parseInt(localStorage.getItem('au-moto'), 10);
        if (moto >= 0 && moto <= 100) {
          radice.style.setProperty('--moto', moto > 0 ? 100 / moto : 0);
        }
      } catch (e) {}

      // La sezione da mostrare è scritta nell'indirizzo. Va letta qui,
      // prima che il corpo della pagina sia disegnato: il router più
      // avanti si limiterà a subentrare.
      //
      // `rinominate` traduce gli identificativi di ieri in quelli di
      // oggi: un indirizzo già mandato a qualcuno, o messo fra i
      // segnalibri, deve continuare a portare dove portava. La barra
      // dell'indirizzo si aggiorna senza aggiungere un passo alla
      // cronologia, così il tasto indietro non rimbalza fra le due
      // forme dello stesso posto.
      var valide = [{% for s in site.sezioni %}'{{ s.id }}'{% if not loop.last %}, {% endif %}{% endfor %}];
      var rinominate = { {% for s in site.sezioni %}{% if s.era %}'{{ s.era }}': '{{ s.id }}'{% if not loop.last %}, {% endif %}{% endif %}{% endfor %} };
      var sezione = 'home';
      try {
        var id = decodeURIComponent(location.hash.replace(/^#/, ''));
        if (rinominate[id]) {
          id = rinominate[id];
          if (history.replaceState) history.replaceState(null, '', '#' + id);
        }
        if (valide.indexOf(id) !== -1) sezione = id;
      } catch (e) {}
      radice.setAttribute('data-sez', sezione);
    })();
{%- endset -%}

{%- set stileSenzaJs -%}
      /* Il selettore è volutamente più specifico di quello del foglio
         principale: così queste regole vincono per specificità e non
         per ordine di dichiarazione. */
      :root .au-section { display: block; opacity: 1; }
      :root .au-nav { display: none; }
      /* Il pulsante del menù aprirebbe un elenco che qui non c'è: le
         sezioni sono già tutte in pagina, una dopo l'altra. */
      :root .au-nav-apri { display: none; }
      /* Senza JavaScript nessuno di questi comandi fa qualcosa: né i
         cursori, né la scelta del tema, né la ricerca. Mostrarli
         sarebbe promettere ciò che non si può mantenere. */
      :root .au-comandi { display: none; }
{%- endset -%}
<!DOCTYPE html>
<html lang="{{ site.lingua }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {#- Content Security Policy. Il sito non ha moduli, né login, né
     contenuti scritti da altri: la policy non ripara una falla
     esistente, ma limita il danno se un giorno finisse nella pagina
     del codice non voluto. Tutto viene da qui ('self'), i due blocchi
     inline sono ammessi per impronta, e l'unica destinazione esterna
     consentita è il conteggio delle visite.
     Va dichiarata in un meta perché GitHub Pages non permette di
     impostare intestazioni HTTP. Per la stessa ragione manca
     frame-ancestors, che in un meta non è ammesso: contro l'inclusione
     in una cornice altrui, su Pages, non c'è rimedio. #}
  <meta http-equiv="Content-Security-Policy" content="
    default-src 'none';
    base-uri 'none';
    {#- Nessun modulo può spedire da nessuna parte, tranne dove una
        pagina lo dichiari con `moduli`. Il modulo dei contatti è
        l'unico del sito che parte davvero: quello dell'oracolo viene
        fermato dal JavaScript, e quello della redazione non è un
        modulo che si spedisce. -#}
    {#- `safe` perché la policy parla per apostrofi — 'self', 'none' —
        e l'autoescape li trasformerebbe in entità: il browser le
        rimetterebbe a posto, ma affidare una regola di sicurezza a un
        giro di decodifica è un rischio inutile. Il valore viene dal
        front matter di questo sito, non da fuori. -#}
    form-action {% if moduli %}{{ moduli | safe }}{% else %}'none'{% endif %};
    img-src 'self';
    font-src 'self';
    style-src 'self' {{ stileSenzaJs | impronta | safe }};
    script-src 'self' {{ avvio | impronta | safe }};
    {#- 'self' serve all'Intelligenza Artificiosa, che alla prima
        domanda scarica l'indice dei testi del sito. È il permesso più
        stretto possibile: nessun'altra origine è raggiungibile.
        `reti` la allarga per una singola pagina — la redazione, che
        deve parlare con l'API di GitHub — e non per tutto il sito. -#}
    connect-src 'self'{% if site.analisi.goatcounter %} https://{{ site.analisi.goatcounter }}.goatcounter.com{% endif %}{% if reti %} {{ reti }}{% endif %};
  ">

  {#- Il titolo della scheda porta anche il nome del sito: una pagina
     singola arriva spesso da fuori, e «Le vere scienze sono quelle
     umanistiche» da solo non dice a chi appartiene. Nell'anteprima
     social invece resta il solo titolo del pezzo, dove il nome del
     sito compare già per conto suo. -#}
  <title>{{ titoloPagina or titolo or site.titolo }}</title>
  <meta name="description" content="{{ descrizione or site.descrizione }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- endif %}

  {#- `article` e non `website` per i singoli pezzi: è la differenza fra
     un sito e uno scritto, e le anteprime la usano. -#}
  <meta property="og:type" content="{{ tipoOg or 'website' }}">
  <meta property="og:site_name" content="{{ site.titolo }}">
  <meta property="og:title" content="{{ titolo or site.titolo }}">
  <meta property="og:description" content="{{ descrizione or site.descrizione }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="it_IT">
  <meta name="twitter:card" content="summary">

  {#- I due disegni del puntatore, chiesti in anticipo.
     Senza, il browser li scarica solo nell'istante in cui servono — e
     fino ad allora disegna il ripiego di sistema. Il risultato è che
     entrando nella pagina si vede ancora la freccia del computer, e
     quella del sito compare più tardi, al primo movimento che cambia
     l'elemento sotto il puntatore: un clic, o il passaggio su un
     collegamento. Non è un ritardo di rete che si possa aspettare, è
     che il cursore viene ridisegnato solo quando c'è motivo di
     ridisegnarlo.

     Le condizioni sono le stesse del foglio di stile: dove il
     puntatore disegnato non varrebbe, i file non vengono nemmeno
     chiesti. Ogni schermo scarica solo la risoluzione che userà. -#}
  {%- set finestraFine = '(pointer: fine) and (prefers-contrast: no-preference)' %}
  <link rel="preload" as="image" href="{{ base }}assets/img/cursore.svg"
        media="{{ finestraFine }} and (max-resolution: 1.9dppx)">
  <link rel="preload" as="image" href="{{ base }}assets/img/mano.svg"
        media="{{ finestraFine }} and (max-resolution: 1.9dppx)">
  <link rel="preload" as="image" href="{{ base }}assets/img/cursore-2x.svg"
        media="{{ finestraFine }} and (min-resolution: 2dppx)">
  <link rel="preload" as="image" href="{{ base }}assets/img/mano-2x.svg"
        media="{{ finestraFine }} and (min-resolution: 2dppx)">

  {#- Perché il lettore di feed lo trovi da sé: chi incolla
     l'indirizzo del sito nel proprio lettore, senza sapere che esiste
     un /feed.xml, viene comunque iscritto. -#}
  <link rel="alternate" type="application/rss+xml"
        title="{{ site.titolo }} — Il Diavolo veste Pravda e articoli"
        href="{{ site.url }}/feed.xml">

  {#- Il colore della barra del browser sul telefono. Non più due
     dichiarazioni legate alle preferenze di sistema, che con tre temi
     non saprebbero quale annunciare: una sola, che lo script qui sotto
     mette in accordo col tema scelto. Deve stare prima di quello
     script, che la cerca per nome. -#}
  <meta name="theme-color" id="au-colore-barra" content="#151d33">
  <link rel="icon" href="{{ base }}assets/img/favicon.svg" type="image/svg+xml">

  {%- if site.analisi.goatcounter %}
  {#- Codice del sito su GoatCounter. Finché resta vuoto in site.json,
      questo meta non compare e non viene caricato alcuno script. #}
  <meta name="analisi-codice" content="{{ site.analisi.goatcounter }}">
  {%- endif %}

  {#- Stato deciso prima del primo disegno, così la pagina non appare
     mai in una veste che va poi corretta sotto gli occhi di chi legge:
     né il tema sbagliato, né la sezione sbagliata. Il codice è quello
     catturato in cima al file, di cui la policy dichiara l'impronta. #}
  <script>{{ avvio | safe }}</script>

  {#- I caratteri stanno in assets/font/ e sono dichiarati in cima al
     foglio di stile: nessuna richiesta a Google, nessun terzo fra il
     lettore e la pagina. Il precaricamento riguarda i due file del
     sottoinsieme latino, gli unici che servono quasi sempre. #}
  <link rel="preload" href="{{ base }}assets/font/archivo-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ base }}assets/font/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>

  {#- L'impronta nell'indirizzo lega la pagina alla versione esatta del
     foglio che le serve. Su GitHub Pages i file restano in cache dieci
     minuti e non si può cambiare: senza questo, una pagina nuova può
     ritrovarsi con lo stile vecchio, e basta un nome di classe cambiato
     perché la pagina si scomponga. -#}
  <link rel="stylesheet" href="{{ base }}assets/css/style.css?v={{ 'src/assets/css/style.css' | versione }}">
  {%- if foglioExtra %}
  {#- Un foglio in più per una pagina sola: la redazione non deve pesare
     sul foglio che scaricano tutti gli altri. -#}
  <link rel="stylesheet" href="{{ base }}assets/css/{{ foglioExtra }}.css?v={{ ('src/assets/css/' + foglioExtra + '.css') | versione }}">
  {%- endif %}
  {%- set entrata = modulo | default('main', true) %}
  {#- L'impronta qui non è quella del solo file d'ingresso ma quella di
     tutti i moduli insieme: l'ingresso ne importa una dozzina, e
     cambiandone uno senza toccare lui il suo indirizzo resterebbe lo
     stesso — con la pagina nuova e il giro di moduli vecchio ancora in
     cache. Gli `import` dentro i file pubblicati portano la stessa
     impronta; li firma la compilazione. -#}
  <script type="module" src="{{ base }}assets/js/{{ entrata }}.js?v={{ null | versioneModuli }}"></script>

  {#- Senza JavaScript il router non può nascondere nulla: si mostra
     tutto, così la pagina resta leggibile e navigabile per intero. #}
  <noscript>
    <style>{{ stileSenzaJs | safe }}</style>
  </noscript>
</head>
<body>
{{ content | safe }}
{%- if not senzaPiede %}
{#- Il piede dice due cose sole, ed è tutto quello che deve dire: a
   quali condizioni si possono usare questi testi, e come seguirli
   senza tornare a controllare. La lente sulle poesie è un dosso; la
   riga della licenza è il fatto giuridico, ed è quella che dà
   appiglio se qualcuno ripubblica. -#}
<footer class="au-piede">
  <div class="au-piede-dentro">
    {%- if site.licenza %}
    <p class="au-piede-riga">
      I testi di questo sito sono di {{ site.nome }} e si possono
      ricondividere per intero, citando l'autore, senza scopo di lucro e
      senza modifiche:
      <a class="au-piede-link" href="{{ site.licenza.url }}"
         rel="license noopener" target="_blank">{{ site.licenza.nome }}</a>.
    </p>
    {%- endif %}
    <p class="au-piede-riga">
      <a class="au-piede-link" href="{{ site.url }}/feed.xml">Feed RSS</a>
      — per seguire Il Diavolo veste Pravda e gli articoli dal proprio
      lettore, senza lasciare un indirizzo a nessuno.
    </p>
  </div>
</footer>
{%- endif %}
</body>
</html>
